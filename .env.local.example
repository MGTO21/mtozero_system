# Firebase web app configuration.
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup.
# These keys are public by design; access is controlled by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The shop owner's sign-in address. The first time this account signs in it is
# granted the 'owner' role. Must match ownerEmail() in firestore.rules.
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com

# --- Product images ---
# Thumbnails always work with no extra service: the browser compresses each photo
# to ~30 KB and stores it inside the product document, so pictures also render
# offline. Firebase Cloud Storage is NOT used and needs no Blaze plan.
#
# The two values below are OPTIONAL and only add a full-resolution copy on
# Cloudinary's free plan (no credit card). Leave them empty to skip it entirely.
# Cloudinary → Settings → Upload → Upload presets → add one with Signing mode:
# Unsigned, then paste its name here along with your cloud name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
